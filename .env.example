# Optional: Gemini API key for multimodal ADK triage/scout/assessor/planner/action/review agents (runs offline if unset)
GOOGLE_API_KEY=

# Optional: Google Maps API key for traffic-aware Routes API ETAs (falls back to haversine road-factor if unset)
GOOGLE_MAPS_API_KEY=

# Gemini model to use when GOOGLE_API_KEY is set
GEMINI_MODEL=gemini-2.5-flash

# Safety gate thresholds enforced inside the `reroute` MCP tool
MIN_CONFIDENCE=0.6
AUTO_COST_LIMIT_INR=15000
LEARN_MIN_SAMPLES=2

# Temporal durability (leave empty to run in-memory asyncio tasks without Temporal)
TEMPORAL_URL=localhost:7233
TEMPORAL_TASK_QUEUE=dock-to-door
TEMPORAL_WF_PREFIX=incident-
NIGHTLY_REVIEW_MIN=1440

# ClickHouse analytics & telemetry sink (leave CLICKHOUSE_URL empty to fall back to SQLite)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=d2d
CLICKHOUSE_USER=d2d
CLICKHOUSE_PASSWORD=d2d
